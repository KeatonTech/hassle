{
  "automation:mixed_triggers_conditions": {
    "id": "mixed_triggers_conditions",
    "alias": "Mixed Triggers and Conditions",
    "triggers": [
      {
        "trigger": "state",
        "entity_id": "binary_sensor.motion",
        "id": "motion"
      },
      {
        "trigger": "state",
        "entity_id": "binary_sensor.door",
        "id": "door"
      },
      {
        "trigger": "time",
        "at": "06:00:00",
        "id": "morning"
      }
    ],
    "conditions": [
      {
        "condition": "and",
        "conditions": [
          {
            "condition": "state",
            "entity_id": "input_boolean.enable",
            "state": "on"
          },
          {
            "condition": "time",
            "weekday": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri"
            ]
          },
          {
            "condition": "template",
            "value_template": "{{ now().hour >= 6 and now().hour < 22 }}"
          }
        ]
      }
    ],
    "actions": [
      {
        "action": "light.turn_on",
        "target": {
          "entity_id": "light.hallway"
        },
        "data": {
          "brightness": 255
        }
      }
    ]
  }
}

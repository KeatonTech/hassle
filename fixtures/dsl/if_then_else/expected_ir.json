{
  "automation:thermostat_if_then": {
    "id": "thermostat_if_then",
    "alias": "Thermostat if/then/else",
    "triggers": [
      {
        "trigger": "state",
        "entity_id": "sensor.temperature",
        "to": "above_25"
      }
    ],
    "conditions": [],
    "actions": [
      {
        "if": [
          {
            "condition": "state",
            "entity_id": "sensor.temperature",
            "state": "above_25"
          }
        ],
        "then": [
          {
            "action": "climate.set_temperature",
            "target": {
              "entity_id": "climate.living_room"
            },
            "data": {
              "temperature": 20
            }
          }
        ],
        "else": [
          {
            "action": "climate.set_temperature",
            "target": {
              "entity_id": "climate.living_room"
            },
            "data": {
              "temperature": 22
            }
          }
        ]
      }
    ]
  }
}

{
  "automation:hall_light_on_motion": {
    "id": "hall_light_on_motion",
    "alias": "Hallway: light on motion",
    "mode": "restart",
    "triggers": [
      {
        "trigger": "state",
        "entity_id": "binary_sensor.hall_motion",
        "to": "on"
      }
    ],
    "conditions": [],
    "actions": [
      {
        "action": "light.turn_on",
        "data": {
          "entity_id": "light.hallway",
          "brightness_pct": 60
        }
      },
      {
        "delay": {
          "minutes": 5
        }
      },
      {
        "action": "light.turn_off",
        "data": {
          "entity_id": "light.hallway"
        }
      }
    ]
  }
}

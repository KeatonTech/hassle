{
  "automation:motion_kitchen": {
    "id": "motion_kitchen",
    "alias": "Motion light: kitchen",
    "triggers": [
      {
        "trigger": "state",
        "entity_id": "binary_sensor.kitchen_motion",
        "to": "on"
      }
    ],
    "conditions": [
      {
        "condition": "state",
        "entity_id": "input_boolean.guest_mode",
        "state": "off"
      }
    ],
    "actions": [
      {
        "action": "light.turn_on",
        "data": {
          "entity_id": "light.kitchen"
        }
      }
    ]
  },

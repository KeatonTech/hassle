{
  "automation:deep_nesting": {
    "id": "deep_nesting",
    "alias": "Deep nesting",
    "triggers": [
      {
        "trigger": "state",
        "entity_id": "binary_sensor.trigger",
        "to": "on"
      }
    ],
    "conditions": [],
    "actions": [
      {
        "choose": [
          {
            "conditions": [
              {
                "condition": "state",
                "entity_id": "input_boolean.armed",
                "state": "on"
              }
            ],
            "sequence": [
              {
                "repeat": {
                  "count": 2,
                  "sequence": [
                    {
                      "if": [
                        {
                          "condition": "state",
                          "entity_id": "sensor.temperature",
                          "state": "above_25"
                        }
                      ],
                      "then": [
                        {
                          "action": "light.turn_on",
                          "target": {
                            "entity_id": "light.hallway"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}

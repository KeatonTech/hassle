{
  "automation:lights_repeat_for_each": {
    "id": "lights_repeat_for_each",
    "alias": "Lights repeat for_each",
    "triggers": [
      {
        "trigger": "state",
        "entity_id": "input_text.entities",
        "to": "changed"
      }
    ],
    "conditions": [],
    "actions": [
      {
        "repeat": {
          "for_each": [
            "light.bedroom",
            "light.kitchen",
            "light.hallway"
          ],
          "sequence": [
            {
              "action": "light.turn_on",
              "target": {
                "entity_id": "{{ repeat.item }}"
              }
            }
          ]
        }
      }
    ]
  }
}

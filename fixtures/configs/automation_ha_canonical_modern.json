{
  "id": "ha_canonical_modern",
  "alias": "HA Canonical Modern",
  "description": "Post-2024.10 HA storage shape verbatim: plural block keys, modern trigger:/action: discriminators, string id, no legacy platform:/service: anywhere, no scalar delay -- exactly what a real live GET returns and what compile(decompile(x)) must reproduce with zero transformations",
  "mode": "restart",
  "triggers": [
    {
      "trigger": "state",
      "entity_id": "binary_sensor.hall_motion",
      "to": "on"
    },
    {
      "trigger": "numeric_state",
      "entity_id": "sensor.temperature",
      "above": 25
    }
  ],
  "conditions": [
    {
      "condition": "state",
      "entity_id": "input_boolean.armed",
      "state": "on"
    },
    {
      "condition": "time",
      "after": "06:00:00",
      "before": "22:00:00"
    }
  ],
  "actions": [
    {
      "choose": [
        {
          "conditions": [
            {
              "condition": "state",
              "entity_id": "light.bedroom",
              "state": "off"
            }
          ],
          "sequence": [
            {
              "action": "light.turn_on",
              "target": {
                "entity_id": "light.bedroom"
              },
              "data": {
                "brightness": 180
              }
            }
          ]
        }
      ],
      "default": [
        {
          "action": "light.turn_off",
          "target": {
            "entity_id": "light.bedroom"
          }
        }
      ]
    },
    {
      "action": "notify.mobile_app",
      "data": {
        "message": "Bedroom light adjusted"
      }
    }
  ]
}

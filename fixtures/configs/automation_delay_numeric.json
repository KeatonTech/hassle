{
  "alias": "Delay Numeric",
  "description": "Demonstrates delay with numeric seconds",
  "trigger": [
    {
      "platform": "state",
      "entity_id": "binary_sensor.motion"
    }
  ],
  "action": [
    {
      "service": "light.turn_on",
      "target": {
        "entity_id": "light.hallway"
      }
    },
    {
      "delay": 30
    },
    {
      "service": "light.turn_off",
      "target": {
        "entity_id": "light.hallway"
      }
    }
  ],
  "mode": "single"
}

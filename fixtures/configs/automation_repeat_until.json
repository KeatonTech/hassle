{
  "alias": "Repeat Until",
  "description": "Demonstrates repeat with until condition",
  "trigger": [
    {
      "platform": "time",
      "at": "12:00:00"
    }
  ],
  "action": [
    {
      "repeat": {
        "until": [
          {
            "condition": "state",
            "entity_id": "input_boolean.done",
            "state": "on"
          }
        ],
        "sequence": [
          {
            "service": "input_boolean.turn_on",
            "target": {
              "entity_id": "input_boolean.done"
            }
          }
        ]
      }
    }
  ],
  "mode": "single"
}

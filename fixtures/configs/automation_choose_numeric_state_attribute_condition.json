{
  "id": "choose_numeric_state_attribute_condition",
  "alias": "Choose Numeric State Attribute Condition",
  "description": "Shape observed in a real 2026.7 UI-authored config: a choose branch's conditions carry a numeric_state condition with attribute (the top-level automation-condition path is covered elsewhere; this fixture pins the nested-in-choose-conditions path through the same decompile_condition dispatcher)",
  "triggers": [
    {
      "trigger": "state",
      "entity_id": ["cover.garage"],
      "to": ["open"]
    }
  ],
  "conditions": [],
  "actions": [
    {
      "choose": [
        {
          "conditions": [
            {
              "condition": "numeric_state",
              "entity_id": "cover.garage",
              "attribute": "current_position",
              "above": 0
            }
          ],
          "sequence": [
            {
              "action": "cover.stop_cover",
              "target": {
                "entity_id": "cover.garage"
              }
            }
          ]
        }
      ]
    }
  ],
  "mode": "single"
}

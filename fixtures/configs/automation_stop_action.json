{
  "alias": "Stop Action",
  "description": "Demonstrates stop action",
  "trigger": [
    {
      "platform": "state",
      "entity_id": "binary_sensor.emergency"
    }
  ],
  "action": [
    {
      "if": [
        {
          "condition": "state",
          "entity_id": "binary_sensor.emergency",
          "state": "on"
        }
      ],
      "then": [
        {
          "stop": "Emergency mode activated"
        }
      ],
      "else": [
        {
          "service": "light.turn_on",
          "target": {
            "entity_id": "light.bedroom"
          }
        }
      ]
    }
  ],
  "mode": "single"
}

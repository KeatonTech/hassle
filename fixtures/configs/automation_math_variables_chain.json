{
  "alias": "Math Variables Chain",
  "description": "Variables with templates consumed by later templates",
  "trigger": [
    {
      "platform": "state",
      "entity_id": "sun.sun"
    }
  ],
  "action": [
    {
      "variables": {
        "elev": "{{ state_attr('sun.sun', 'elevation') | float }}",
        "factor": "{{ sin(elev * pi / 180) }}"
      }
    },
    {
      "service": "light.turn_on",
      "target": {
        "entity_id": "light.bedroom"
      },
      "data": {
        "brightness": "{{ (255 * factor) | round(0) }}"
      }
    }
  ],
  "mode": "single"
}

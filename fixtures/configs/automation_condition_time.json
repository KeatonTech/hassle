{
  "alias": "Condition Time",
  "description": "Automation with time condition",
  "trigger": [
    {
      "platform": "state",
      "entity_id": "binary_sensor.motion"
    }
  ],
  "condition": [
    {
      "condition": "time",
      "after": "22:00:00",
      "before": "06:00:00",
      "weekday": ["mon", "tue", "wed", "thu", "fri"]
    }
  ],
  "action": [
    {
      "service": "light.turn_on",
      "target": {
        "entity_id": "light.bedroom"
      },
      "data": {
        "brightness": 50
      }
    }
  ],
  "mode": "single"
}

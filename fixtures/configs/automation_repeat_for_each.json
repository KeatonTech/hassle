{
  "alias": "Repeat For Each",
  "description": "Demonstrates repeat with for_each",
  "trigger": [
    {
      "platform": "state",
      "entity_id": "input_text.entities"
    }
  ],
  "action": [
    {
      "repeat": {
        "for_each": [
          "light.bedroom",
          "light.kitchen",
          "light.hallway"
        ],
        "sequence": [
          {
            "service": "light.turn_on",
            "target": {
              "entity_id": "{{ repeat.item }}"
            }
          }
        ]
      }
    }
  ],
  "mode": "single"
}

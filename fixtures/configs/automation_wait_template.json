{
  "alias": "Wait Template",
  "description": "Demonstrates wait_template action",
  "trigger": [
    {
      "platform": "state",
      "entity_id": "binary_sensor.motion"
    }
  ],
  "action": [
    {
      "wait_template": "{{ state_attr('light.hallway', 'brightness') > 100 }}",
      "timeout": "00:05:00"
    },
    {
      "service": "light.turn_off",
      "target": {
        "entity_id": "light.hallway"
      }
    }
  ],
  "mode": "single"
}

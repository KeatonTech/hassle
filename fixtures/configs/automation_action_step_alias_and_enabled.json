{
  "id": "action_step_alias_and_enabled",
  "alias": "Action Step Alias And Enabled",
  "description": "Shape observed in a real 2026.7 UI-authored config: the UI names steps (per-action alias) and toggles them (per-action enabled), on a plain service call and a delay",
  "triggers": [
    {
      "trigger": "state",
      "entity_id": ["binary_sensor.bedroom_motion"],
      "to": ["on"]
    }
  ],
  "conditions": [],
  "actions": [
    {
      "alias": "Turn on bedroom",
      "action": "light.turn_on",
      "target": {
        "entity_id": "light.bedroom"
      }
    },
    {
      "alias": "Wait a bit",
      "delay": {
        "seconds": 5
      },
      "enabled": true
    },
    {
      "alias": "Disabled cleanup step",
      "action": "light.turn_off",
      "target": {
        "entity_id": "light.bedroom"
      },
      "enabled": false
    }
  ],
  "mode": "single"
}

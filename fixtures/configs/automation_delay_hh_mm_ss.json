{
  "alias": "Delay HH:MM:SS",
  "description": "Demonstrates delay with hh:mm:ss format",
  "trigger": [
    {
      "platform": "state",
      "entity_id": "binary_sensor.presence"
    }
  ],
  "action": [
    {
      "service": "light.turn_on",
      "target": {
        "entity_id": "light.bedroom"
      }
    },
    {
      "delay": "00:05:30"
    },
    {
      "service": "light.turn_off",
      "target": {
        "entity_id": "light.bedroom"
      }
    }
  ],
  "mode": "single"
}
